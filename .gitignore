state/
incoming/*
!incoming/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Scratch/debug artifacts from local testing
*.tmp
*.tmp.html
*.tmp.csv
_new_template.html.txt
